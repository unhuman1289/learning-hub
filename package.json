{
  "name": "learning-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/wrangler-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.jsonc --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "deploy:production": "node --import ./scripts/wrangler-env.mjs scripts/deploy-production.mjs",
    "deploy:staging": "node scripts/release.mjs staging",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern '.claude/worktrees/**' --ignore-pattern 'work/**' --ignore-pattern '.wrangler/**'",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:import:staging": "node scripts/d1-import.mjs",
    "db:verify:staging": "node scripts/d1-verify.mjs",
    "db:migrate:local": "node scripts/local-db.mjs migrate",
    "db:drill:learner-migration": "node scripts/learner-migration-drill.mjs",
    "db:restore:local": "node scripts/restore-export.mjs",
    "db:restore:drill": "node scripts/restore-drill.mjs",
    "contracts:schema": "node --experimental-strip-types scripts/contracts-schema.mjs",
    "contracts:check": "node --experimental-strip-types scripts/contracts-schema.mjs --check",
    "seed:hub2": "node --experimental-strip-types scripts/seed-hub2.mjs",
    "deploy:mcp:staging": "node --import ./scripts/wrangler-env.mjs ./node_modules/wrangler/bin/wrangler.js deploy --config wrangler.mcp.jsonc --env staging",
    "dev:profiles": "node scripts/dev-profiles.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:seed": "LEARNING_HUB_LOCAL_STATE=${LEARNING_HUB_DEMO_STATE:-.wrangler/state-demo} npm run seed:hub2",
    "runner:fake": "node --experimental-strip-types scripts/fake-runner.mjs --credentials .wrangler/demo-runner.json",
    "runner:local": "node --experimental-strip-types scripts/run-demo-qwen.mjs",
    "dev:fresh": "npm run dev:setup && npm run dev:seed && npm run build",
    "qwen:replay": "node --experimental-strip-types scripts/qwen-replay.mjs",
    "test:e2e": "playwright test",
    "test:e2e:u5": "playwright test --config playwright.u5.config.mjs"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.3.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
