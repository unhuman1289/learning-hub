{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-hub-local",
  "main": "./build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local",
    "APP_VERSION": "local",
    "DEPLOYMENT_ID": "learning-hub-local",
    "HUB2_ENABLED": "true",
    "APP_ENV": "local",
    "AI_JOBS_DAILY_CAP": "300"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learning-hub",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "learning-hub-uploads-local"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "learning-hub-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ENV": "staging",
        "APP_VERSION": "hub2-qwen-only-2026-11-11",
        "DEPLOYMENT_ID": "learning-hub-staging",
        "STAGING_SPIKE_LOCKDOWN": "false",
        "APP_ORIGIN": "https://learning-hub-staging.tranvu-812.workers.dev",
        "EMAIL_FROM": "Learning Hub <no-reply@notify.unhuman.cc>",
        "ACCESS_TEAM_DOMAIN": "https://unhuman-lab.cloudflareaccess.com",
        "AUTOMATION_ACCESS_AUD": "7c55439963964a7cb0a0597600f7fad2f932b80bbd650703aca1f321e0e751ef",
        "HUB2_ENABLED": "true",
        "AI_JOBS_DAILY_CAP": "300",
        "AI_COST_ALERT_USD": "3"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learning-hub-staging",
          "database_id": "6f2f1df1-1dcd-4810-8812-1c6e4d7ef1d5",
          "migrations_dir": "drizzle"
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": false
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "learning-hub-backups-staging"
        },
        {
          "binding": "UPLOADS",
          "bucket_name": "learning-hub-uploads-staging"
        }
      ],
      "triggers": {
        "crons": [
          "0 1-5,22,23 * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "queue": "learning-hub-ai-staging",
            "binding": "AI_QUEUE"
          }
        ]
      },
      "services": [
        {"binding":"EVENT_DISPATCHER","service":"learning-hub-mcp-staging","entrypoint":"EventDispatcher"}
      ]
    },
    "production": {
      "name": "learning-hub-prod",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "learn.unhuman.cc",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "hub2-notebook-ux-2026-11-12",
        "AUTOMATION_ACCESS_AUD": "12226aa41dcf2129353292351daf364eb49b0b5c27cc0b07de7099c43ce30b84",
        "HOUSEHOLD_GATE": "passphrase",
        "APP_ENV": "production",
        "AI_JOBS_DAILY_CAP": "300",
        "HUB2_ENABLED": "true",
        "MCP_ENABLED": "false",
        "MCP_EVENTS_ENABLED": "false",
        "AI_LOCAL_ONLY": "true",
        "DEPLOYMENT_ID": "learning-hub-production",
        "APP_ORIGIN": "https://learn.unhuman.cc",
        "EMAIL_FROM": "Learning Hub <no-reply@notify.unhuman.cc>",
        "ACCESS_TEAM_DOMAIN": "https://unhuman-lab.cloudflareaccess.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learning-hub-prod",
          "database_id": "545cedea-a4a5-4bdb-b370-8d447fe0833c",
          "migrations_dir": "drizzle"
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": false
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "learning-hub-backups-production"
        },
        {
          "binding": "UPLOADS",
          "bucket_name": "learning-hub-uploads-production"
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
