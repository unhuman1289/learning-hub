# Copy to ~/.config/learning-hub/home-runner.env and run: chmod 600 ~/.config/learning-hub/home-runner.env
# Names only; never commit real values.
HUB_BASE_URL=https://learning-hub-staging.tranvu-812.workers.dev
HUB_BEARER=
HUB_ACCESS_CLIENT_ID=
HUB_ACCESS_CLIENT_SECRET=

# Qwen through LM Studio (Developer → Start server). Leave QWEN_VISION=0 until photos pass the eval.
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen/qwen3.6-35b-a3b
QWEN_VISION=0

# Codex CLI signed in with ChatGPT (run `codex login` once). The default in ~/.codex/config.toml may be a model the ChatGPT plan no longer serves; pick one from `codex debug models`.
CODEX_BIN=codex
CODEX_MODEL=gpt-6.1-sol

# Claude Code as a backup; off until installed and signed in.
CLAUDE_ENABLED=0
# 1 = also write the nightly lessons (plan daily, queued 00:00 Berlin) with Codex. 0 = leave them to ChatGPT.
RUNNER_DAILY=1
CLAUDE_BIN=claude

# Optional: once a day after 03:00, copy each profile's history (Markdown) into a Google Drive for desktop folder.
# Needs the history:read scope and the profiles in the client's learnerIds. One-way: edits on Drive never reach the Hub.
DRIVE_MIRROR_DIR=
DRIVE_MIRROR_PROFILES=
