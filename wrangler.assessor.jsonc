{
  "name": "learning-hub-assessor-local",
  "main": "integrations/assessor/src/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "vars": {
    "ASSESSOR_ENABLED": "false",
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "HUB_ORIGIN": "https://learning-hub-staging.tranvu-812.workers.dev",
    "PILOT_LEARNER_REF": "lrn_e71107bec49e",
    "PILOT_SUBJECT_ID": "sub_ecdc2fc90377f3010410"
  },
  "env": {
    "staging": {
      "name": "learning-hub-assessor-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ASSESSOR_ENABLED": "false",
        "ANTHROPIC_MODEL": "claude-opus-5-5",
        "HUB_ORIGIN": "https://learning-hub-staging.tranvu-812.workers.dev",
        "PILOT_LEARNER_REF": "lrn_e71107bec49e",
        "PILOT_SUBJECT_ID": "sub_ecdc2fc90377f3010410"
      },
      "triggers": {
        "crons": [
          "7 * * * *"
        ]
      },
      "queues": {
        "consumers": [
          {
            "queue": "learning-hub-ai-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 2,
            "retry_delay": 300
          }
        ]
      }
    },
    "production": {
      "name": "learning-hub-assessor-prod",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ASSESSOR_ENABLED": "false",
        "ANTHROPIC_MODEL": "claude-opus-5-5",
        "HUB_ORIGIN": "https://learn.unhuman.cc",
        "PILOT_LEARNER_REF": "lrn_a1d52b2f2565",
        "PILOT_SUBJECT_ID": "sub_94c4c4d6e62d8d8b4d4c"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
