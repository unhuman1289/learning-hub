{
  "$id": "learning-hub/assess-result-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "assess-result/1"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "grades": {
      "maxItems": 25,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "correct",
              "partial",
              "incorrect",
              "ungradable"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rubricScores": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion": {
                  "type": "string",
                  "maxLength": 200
                },
                "points": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "max": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "criterion",
                "points",
                "max"
              ],
              "additionalProperties": false
            }
          },
          "feedback": {
            "type": "string",
            "maxLength": 800
          },
          "correction": {
            "type": "string",
            "maxLength": 3000
          },
          "errors": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skillId": {
                  "type": "string",
                  "pattern": "^(sk_|key:)[a-zA-Z0-9_-]{1,80}$"
                },
                "patternId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "label": {
                  "type": "string",
                  "maxLength": 120
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "knowledge",
                    "application",
                    "slip",
                    "reading",
                    "unknown"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "skillId",
                "label",
                "category",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "checkItem": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^i\\d{1,2}$"
                  },
                  "activity": {
                    "type": "string",
                    "enum": [
                      "recall",
                      "recognize",
                      "correct",
                      "transform",
                      "apply",
                      "explain",
                      "create",
                      "investigate"
                    ]
                  },
                  "input": {
                    "type": "string",
                    "enum": [
                      "choice",
                      "short",
                      "long"
                    ]
                  },
                  "skills": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(sk_[A-Za-z0-9]{6,40}|key:[a-z0-9-]{1,80})$"
                    }
                  },
                  "difficulty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "instructions": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "choices": {
                    "minItems": 2,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f]$"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "errorLabel": {
                          "type": "string",
                          "maxLength": 120
                        }
                      },
                      "required": [
                        "id",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "key": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "choice"
                          },
                          "correct": {
                            "minItems": 1,
                            "maxItems": 6,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-f]$"
                            }
                          }
                        },
                        "required": [
                          "type",
                          "correct"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "numeric"
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          },
                          "unit": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 20
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "value",
                          "tolerance",
                          "unit"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "text"
                          },
                          "accepted": {
                            "minItems": 1,
                            "maxItems": 10,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          },
                          "caseSensitive": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "type",
                          "accepted",
                          "caseSensitive"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "rubric": {
                    "minItems": 2,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "criterion": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "points": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 300
                        },
                        "skill": {
                          "type": "string",
                          "pattern": "^(sk_[A-Za-z0-9]{6,40}|key:[a-z0-9-]{1,80})$"
                        }
                      },
                      "required": [
                        "criterion",
                        "points"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "hints": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "solution": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "attachment": {
                    "type": "string",
                    "enum": [
                      "none",
                      "optional",
                      "required"
                    ]
                  }
                },
                "required": [
                  "id",
                  "activity",
                  "input",
                  "skills",
                  "difficulty",
                  "prompt",
                  "hints",
                  "solution",
                  "attachment"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "attemptId",
          "result",
          "score",
          "rubricScores",
          "feedback",
          "correction",
          "errors",
          "checkItem"
        ],
        "additionalProperties": false
      }
    },
    "diagnosis": {
      "maxItems": 25,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "errors": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skillId": {
                  "type": "string",
                  "pattern": "^(sk_|key:)[a-zA-Z0-9_-]{1,80}$"
                },
                "patternId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "label": {
                  "type": "string",
                  "maxLength": 120
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "knowledge",
                    "application",
                    "slip",
                    "reading",
                    "unknown"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "skillId",
                "label",
                "category",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "attemptId",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "masteryProposals": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^(sk_|key:)[a-zA-Z0-9_-]{1,80}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_assessed",
              "introduced",
              "developing",
              "demonstrated",
              "needs_review"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "evidenceAttemptIds": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "skillId",
          "status",
          "reason",
          "evidenceAttemptIds"
        ],
        "additionalProperties": false
      }
    },
    "errorPatternUpdates": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "patternId": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "improving",
              "resolve"
            ]
          },
          "evidenceAttemptIds": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "patternId",
          "action",
          "evidenceAttemptIds"
        ],
        "additionalProperties": false
      }
    },
    "reviewProposals": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^(sk_|key:)[a-zA-Z0-9_-]{1,80}$"
          },
          "inDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "retention",
              "remediation"
            ]
          }
        },
        "required": [
          "skillId",
          "inDays",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "recheckDecision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "upheld",
                "overturned",
                "item_void"
              ]
            },
            "explanation": {
              "type": "string",
              "maxLength": 800
            }
          },
          "required": [
            "decision",
            "explanation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 120
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "cacheReadTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWriteTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model",
        "inputTokens",
        "outputTokens",
        "ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "contextHash",
    "summary",
    "grades",
    "diagnosis",
    "masteryProposals",
    "errorPatternUpdates",
    "reviewProposals",
    "recheckDecision",
    "usage"
  ],
  "additionalProperties": false
}
