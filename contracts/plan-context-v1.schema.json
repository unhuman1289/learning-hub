        "voices": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "de-DE",
              "zh-CN",
              "en-US",
              "vi-VN"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "f": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "m": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "f",
              "m"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "languages",
        "voices"
      ],
      "additionalProperties": false
