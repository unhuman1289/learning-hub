                "title": {
                  "type": "string",
                  "maxLength": 160
                },
                "objective": {
                  "type": "string",
                  "maxLength": 500
                },
                "situation": {
                  "type": "string",
                  "maxLength": 300
                },
                "skills": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(sk_|key:)[a-zA-Z0-9_-]{1,80}$"
