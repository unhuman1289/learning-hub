{
  "$id": "learning-hub/plan-context-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "plan-context/1"
    },
    "jobId": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "daily",
        "initial",
        "request"
      ]
    },
    "learningDay": {
      "type": "string",
      "maxLength": 10
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Berlin"
    },
    "contextHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "versionSeq": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "forStepIds": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingForStepIds": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "heading": {
                "type": "string",
                "maxLength": 180
              },
              "body": {
                "type": "string",
                "maxLength": 1500
              },
              "sourceId": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "maxLength": 250
              },
              "publisher": {
                "type": "string",
                "maxLength": 150
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "read_scope": {
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "abstract"
                ]
              },
              "score": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "heading",
              "body",
              "sourceId",
              "url",
              "title",
              "publisher",
              "published_at",
              "read_scope",
              "score"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "versionSeq",
        "notes"
      ],
      "additionalProperties": false
    },
    "learner": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^lrn_[a-f0-9]{12}$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": [
            "adult",
            "child"
          ]
        },
        "explainLanguage": {
          "type": "string",
          "maxLength": 10
        },
        "personalPrompt": {
          "type": "string",
          "maxLength": 4000
        },
        "targetMinutes": {
          "type": "number"
        },
        "preferences": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "studyMinutes14d": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "maxLength": 10
              },
              "minutes": {
                "type": "number"
              }
            },
            "required": [
              "day",
              "minutes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ref",
        "displayName",
        "role",
        "explainLanguage",
        "personalPrompt",
        "targetMinutes",
        "preferences",
        "studyMinutes14d"
