    "tts": {
      "type": "object",
      "properties": {
        "languages": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "de-DE",
              "zh-CN",
              "en-US",
              "vi-VN"
