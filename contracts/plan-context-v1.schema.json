              "itemKinds": {
                "minItems": 1,
                "maxItems": 9,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "choice",
                    "short",
                    "long",
                    "cloze",
                    "order",
                    "code",
                    "table",
                    "label",
