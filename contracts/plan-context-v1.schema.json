    "policy": {
      "type": "object",
      "properties": {
        "maxPrimaryPerSubjectPerDay": {
          "type": "number",
          "const": 1
        },
        "maxReviewSetsPerSubjectPerDay": {
          "type": "number",
          "const": 1
        },
        "extraLessonsLeftToday": {
          "type": "number"
        },
        "maxOpenMinutes": {
          "type": "number"
        },
        "openMinutesNow": {
          "type": "number"
        },
        "historyDays": {
          "type": "number",
          "const": 14
        },
        "duplicateWindowDays": {
          "type": "number",
          "const": 90
        }
      },
      "required": [
        "maxPrimaryPerSubjectPerDay",
        "maxReviewSetsPerSubjectPerDay",
        "extraLessonsLeftToday",
        "maxOpenMinutes",
        "openMinutesNow",
        "historyDays",
        "duplicateWindowDays"
      ],
      "additionalProperties": false
    },
    "planningGuidance": {
      "type": "string",
      "maxLength": 2000
