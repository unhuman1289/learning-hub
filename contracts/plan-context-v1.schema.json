    "adaptive": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "learn",
            "practice",
            "review",
            "challenge",
            "personal",
            "none"
          ]
        },
        "minutes": {
          "anyOf": [
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 45
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "title",
                "skills"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "targetSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needsScaffold": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "next_step",
            "step_practice",
            "challenge_ready",
            "confirmed_error",
            "reviews_due",
            "scaffold",
            "roadmap_empty",
            "personal"
          ]
        },
        "stepRole": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "intro",
                "practice",
                "challenge",
                "placement"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "listening": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "roadmapTask": {
          "type": "string",
          "enum": [
            "replan",
            "extend",
            "none"
          ]
        }
      },
      "required": [
        "mode",
        "minutes",
        "step",
        "targetSkills",
        "needsScaffold",
        "reason"
      ],
      "additionalProperties": false
    },
    "roadmapProtocol": {
      "type": "number",
      "const": 2
